{
  "radius": {
    "none": {
      "$type": "dimension",
      "$value": "0px",
      "$description": "Table cells, full-bleed panes, anything that butts against another edge."
    },
    "xs": {
      "$type": "dimension",
      "$value": "2px",
      "$description": "Status chips, badges, tags, keyboard-key hints."
    },
    "sm": {
      "$type": "dimension",
      "$value": "3px",
      "$description": "Checkboxes and small inline controls."
    },
    "md": {
      "$type": "dimension",
      "$value": "4px",
      "$description": "Buttons, inputs, selects, segmented controls."
    },
    "lg": {
      "$type": "dimension",
      "$value": "6px",
      "$description": "Panels, cards, detail panes, banners: containers on the canvas."
    },
    "xl": {
      "$type": "dimension",
      "$value": "8px",
      "$description": "Floating layers: menus, popovers, comboboxes, toasts, dialogs. Largest level."
    },
    "full": {
      "$type": "dimension",
      "$value": "9999px",
      "$description": "Status dots and avatars only. Never buttons or chips."
    }
  },
  "shadow": {
    "1": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "2px",
          "spread": "0px",
          "color": "#0F10111A"
        },
        {
          "offsetX": "0px",
          "offsetY": "4px",
          "blur": "12px",
          "spread": "0px",
          "color": "#0F101124"
        }
      ],
      "$description": "Floating level 1: menus, popovers, comboboxes, tooltips, toasts. Color: neutral 950 at 10% and 14%."
    },
    "2": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "2px",
          "blur": "4px",
          "spread": "0px",
          "color": "#0F10111F"
        },
        {
          "offsetX": "0px",
          "offsetY": "12px",
          "blur": "32px",
          "spread": "0px",
          "color": "#0F101133"
        }
      ],
      "$description": "Floating level 2: dialogs and anything opened above a level-1 layer. Color: neutral 950 at 12% and 20%."
    }
  },
  "color": {
    "scrim": {
      "$type": "color",
      "$value": "#0F101166",
      "$description": "Behind dialogs: neutral 950 at 40%."
    }
  }
}