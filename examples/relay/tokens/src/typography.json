        "$type": "fontFamily",
        "$value": "{font.sans}"
      },
      "size": {
        "$type": "dimension",
        "$value": "{size.xs}"
      },
      "weight": {
        "$type": "fontWeight",
        "$value": 600
      },
      "line-height": {
