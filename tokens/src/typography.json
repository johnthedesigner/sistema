{
  "font": {
    "sans": {
      "$type": "fontFamily",
      "$value": [
        "Inter",
        "system-ui",
        "sans-serif"
      ]
    },
    "serif": {
      "$type": "fontFamily",
      "$value": [
        "Fraunces",
        "Georgia",
        "serif"
      ]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": [
        "JetBrains Mono",
        "ui-monospace",
        "monospace"
      ]
    }
  },
  "size": {
    "$description": "From the type scale tool, 2026-11-21: base 16px, major third (1.25), rounded.",
    "xs": {
      "$type": "dimension",
      "$value": "10px"
    },
    "sm": {
      "$type": "dimension",
      "$value": "13px"
    },
    "base": {
      "$type": "dimension",
      "$value": "16px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "20px"
    },
    "xl": {
      "$type": "dimension",
      "$value": "25px"
    },
    "2xl": {
      "$type": "dimension",
      "$value": "31px"
    },
    "3xl": {
      "$type": "dimension",
      "$value": "39px"
    },
    "4xl": {
      "$type": "dimension",
      "$value": "49px"
    },
    "5xl": {
      "$type": "dimension",
      "$value": "61px"
    }
  },
  "type": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.serif}",
        "fontSize": "{size.5xl}",
        "fontWeight": 600,
        "lineHeight": 1.05,
        "letterSpacing": "-0.025em"
      },
      "$description": "The home page headline."
    },
    "heading-xl": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.serif}",
        "fontSize": "{size.3xl}",
        "fontWeight": 600,
        "lineHeight": 1.15,
        "letterSpacing": "-0.02em"
      },
      "$description": "Page titles."
    },
    "heading-lg": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.serif}",
        "fontSize": "{size.2xl}",
        "fontWeight": 600,
        "lineHeight": 1.2,
        "letterSpacing": "-0.015em"
      },
      "$description": "Section headings in guides."
    },
    "heading-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.serif}",
        "fontSize": "{size.xl}",
        "fontWeight": 600,
        "lineHeight": 1.3,
        "letterSpacing": "-0.01em"
      },
      "$description": "Subsection headings."
    },
    "heading-sm": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "{size.lg}",
        "fontWeight": 600,
        "lineHeight": 1.35,
        "letterSpacing": "0"
      },
      "$description": "Small headings in cards and tables."
    },
    "body-lg": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "{size.lg}",
        "fontWeight": 400,
        "lineHeight": 1.6,
        "letterSpacing": "0"
      },
      "$description": "Lead paragraphs."
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "{size.base}",
        "fontWeight": 400,
        "lineHeight": 1.6,
        "letterSpacing": "0"
      },
      "$description": "Reading and interface text."
    },
    "body-sm": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "{size.sm}",
        "fontWeight": 400,
        "lineHeight": 1.5,
        "letterSpacing": "0"
      },
      "$description": "Dense reference and table text."
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "{size.sm}",
        "fontWeight": 500,
        "lineHeight": 1.35,
        "letterSpacing": "0.01em"
      },
      "$description": "Buttons, form labels, navigation."
    },
    "caption": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "12px",
        "fontWeight": 400,
        "lineHeight": 1.4,
        "letterSpacing": "0.01em"
      },
      "$description": "Captions and metadata. Hand-tuned from 10px to 12px: the tool step is too small to read."
    },
    "code": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.mono}",
        "fontSize": "{size.sm}",
        "fontWeight": 400,
        "lineHeight": 1.6,
        "letterSpacing": "0"
      },
      "$description": "Code, prompts, and token names."
    }
  }
}
