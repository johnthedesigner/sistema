{
  "name": "sistema",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:tunnel": "node tools/dev-tunnel.mjs",
    "prebuild": "npm run -s check:content -- --strict-all",
    "build": "next build",
    "postbuild": "npm run -s check:content -- --output-only --strict",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "check:content": "tsx tools/validate/content/cli.ts",
    "uses": "tsx tools/validate/content/uses.ts",
    "palettes": "npx tsx tools/generate-palette-library.ts",
    "tokens": "node style-dictionary.config.mjs",
    "favicons": "node tools/generate-favicons.mjs",
    "og": "node tools/screenshot-og.mjs",
    "build:og": "next build && node tools/screenshot-og.mjs"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@vercel/analytics": "^2.0.1",
    "culori": "^4.0.2",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.3.2",
    "lucide-react": "^1.16.0",
    "next": "^15.3.2",
    "posthog-js": "^1.373.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/culori": "^4.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10",
    "eslint": "^9",
    "eslint-config-next": "^15.3.2",
    "playwright": "^1.60.0",
    "postcss": "^8",
    "sharp": "^0.33.5",
    "style-dictionary": "^5.4.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
